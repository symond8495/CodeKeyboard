<Window x:Class="CodeKeyboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CodeKeyboard"
        mc:Ignorable="d"
        Title="CodeKeyboard"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True" HorizontalAlignment="Left" VerticalAlignment="Top"
        Loaded="WindowMain_Loaded" Closing="WindowMain_Closing">
    <StackPanel x:Name="LayoutRoot">
        <StackPanel x:Name="BlackKeys" Height="150" Orientation="Horizontal" Margin="0,0,0,-140" Panel.ZIndex="1">
            <Button x:Name="Key_Csharp" Content="C#" Margin="22,5,5,5" Width="40" Focusable="False" Click="Key_Click" Grid.IsSharedSizeScope="True"/>
            <Button x:Name="Key_Dsharp" Content="D#" Margin="32,5,5,5" Width="40" Focusable="False" Click="Key_Click"/>
            <Button x:Name="Key_Fsharp" Content="F#" Margin="40.1,5,5,5" Width="40" Focusable="False" Click="Key_Click"/>
            <Button x:Name="Key_Gsharp" Content="G#" Margin="21,5,5,5" Width="40" Focusable="False" Click="Key_Click"/>
            <Button x:Name="Key_Asharp" Content="A#" Margin="21,5,5,5" Width="40" Focusable="False" Click="Key_Click"/>
        </StackPanel>
        <StackPanel x:Name="WhiteKeys" Height="230" Orientation="Horizontal">
            <Button x:Name="Key_C" Margin="2" Width="50" Focusable="False" Click="Key_Click">
                <TextBlock Text="C" Padding="0,130,0,0"/>
            </Button>
            <Button x:Name="Key_D" Margin="2" Width="50" Focusable="False" Click="Key_Click">
                <TextBlock Text="D" Padding="0,130,0,0"/>
            </Button>
            <Button x:Name="Key_E" Margin="2" Width="50" Focusable="False" Click="Key_Click">
                <TextBlock Text="E" Padding="0,130,0,0"/>
            </Button>
            <Button x:Name="Key_F" Margin="2" Width="50" Focusable="False" Click="Key_Click">
                <TextBlock Text="F" Padding="0,130,0,0"/>
            </Button>
            <Button x:Name="Key_G" Margin="2" Width="50" Focusable="False" Click="Key_Click">
                <TextBlock Text="G" Padding="0,130,0,0"/>
            </Button>
            <Button x:Name="Key_A" Margin="2" Width="50" Focusable="False" Click="Key_Click">
                <TextBlock Text="A" Padding="0,130,0,0"/>
            </Button>
            <Button x:Name="Key_B" Margin="2" Width="50" Focusable="False" Click="Key_Click">
                <TextBlock Text="B" Padding="0,130,0,0"/>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
